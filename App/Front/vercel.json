    {
       "rewrites": [
         {
           "source": "/api/:path*",
           "destination": "https://GoEvo.onrender.com/api/:path*"
         }
       ],
       "headers": [
         {
           "source": "/game/:path*",
           "headers": [
             {
               "key": "Cross-Origin-Opener-Policy",
               "value": "same-origin"
             },
             {
               "key": "Cross-Origin-Embedder-Policy",
               "value": "require-corp"
             }
           ]
         }
       ]
     }